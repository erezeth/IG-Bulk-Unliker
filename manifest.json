{
  "manifest_version": 3,
  "name": "IG Bulk Unliker",
  "version": "1.3",
  "description": "Batal suka banyak postingan sekaligus lewat halaman Aktivitas Anda > Suka di Instagram.",
  "permissions": ["debugger"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
